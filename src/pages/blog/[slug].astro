---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content } = await render(post);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title={`${post.data.title} | Astro Toolbox`}>
  <article class="max-w-2xl mx-auto px-4">
    <h1 class="text-3xl font-bold mb-2">{post.data.title}</h1>
    <time class="text-sm text-gray-500 block mb-8" datetime={fmt(post.data.date)}>
      {fmt(post.data.date)}
    </time>
    <div class="prose-content space-y-4 leading-relaxed">
      <Content />
    </div>
    <p class="mt-10"><a class="text-blue-600 hover:underline" href={`${base}blog/`}>← 返回列表</a></p>
  </article>
</BaseLayout>

<style>
  /* 纯文本文章的基础排版（不依赖 typography 插件） */
  article :global(h2) { font-size: 1.5rem; font-weight: 700; margin: 2rem 0 0.5rem; }
  article :global(h3) { font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
  article :global(p) { margin: 0.75rem 0; }
  article :global(ul), article :global(ol) { padding-left: 1.5rem; margin: 0.75rem 0; }
  article :global(ul) { list-style: disc; }
  article :global(ol) { list-style: decimal; }
  article :global(li) { margin: 0.25rem 0; }
  article :global(blockquote) { border-left: 4px solid #cbd5e1; padding-left: 1rem; color: #64748b; margin: 1rem 0; }
  article :global(code) { background: #f1f5f9; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875em; }
  article :global(pre) { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 1rem; overflow-x: auto; margin: 1rem 0; }
  article :global(pre code) { background: none; padding: 0; }
  article :global(a) { color: #2563eb; text-decoration: underline; }
  article :global(hr) { border-color: #e2e8f0; margin: 2rem 0; }
</style>
