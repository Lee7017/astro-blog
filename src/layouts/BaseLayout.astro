---
import '../styles/global.css'

interface Props {
  title?: string;
}

const { title = 'Astro Toolbox' } = Astro.props;
const base = import.meta.env.BASE_URL;
const isGithubPages = base !== '/';
const url = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <h2>Astro Toolbox</h2>
      <nav>
        <a href={url('/')}>Home</a> |
        <a href={url('/tools/tts/')}>TTS</a> |
        <a href={url('/blog/')}>Blog</a>
        {!isGithubPages && <> | <a href={url('/admin/')}>写作</a></>}
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
